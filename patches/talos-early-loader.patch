+package gpuunlock
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestBarrier(t *testing.T) {
+	for _, test := range []struct {
+		name, args                     string
+		failCheck, failLoad, wantError bool
+		wantCalls                      []string
+	}{
+		{"disabled", "", false, false, false, nil},
+		{"one", "gpu_unlock.targets=0000:01:00.0", false, false, false, []string{"discover", "check", "load"}},
+		{"all", "gpu_unlock.targets=all", false, false, false, []string{"discover", "check", "load"}},
+		{"bound", "gpu_unlock.targets=all", true, false, true, []string{"discover", "check"}},
+		{"insertion", "gpu_unlock.targets=all", false, true, true, []string{"discover", "check", "load"}},
+		{"absent", "gpu_unlock.targets=0000:03:00.0", false, false, true, []string{"discover"}},
+		{"duplicate", "gpu_unlock.targets=all gpu_unlock.targets=all", false, false, true, nil},
+		{"empty", "gpu_unlock.targets=", false, false, true, nil},
+		{"mixed", "gpu_unlock.targets=all,0000:01:00.0", false, false, true, []string{"discover"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var calls []string
+			err := Run(test.args, Operations{
+				Discover: func() (map[string]bool, error) {
+					calls = append(calls, "discover")
+					return map[string]bool{"0000:01:00.0": true, "0000:02:00.0": true}, nil
+				},
+				Check: func(targets []string) error {
+					calls = append(calls, "check")
+					if test.failCheck {
+						return errors.New("bound")
+					}
+					return nil
+				},
+				Load: func(parameters string, targets []string) error {
+					calls = append(calls, "load")
+					if parameters == "targets=all" && len(targets) != 2 {
+						t.Fatal(targets)
+					}
+					if test.failLoad {
+						return errors.New("load")
+					}
+					return nil
+				},
+			})
+			if (err != nil) != test.wantError || !reflect.DeepEqual(calls, test.wantCalls) {
+				t.Fatalf("err=%v calls=%v", err, calls)
+			}
+		})
+	}
+}
+
+func TestBarrierWaitsForInsertionCompletion(t *testing.T) {
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	go func() {
+		done <- Run("gpu_unlock.targets=all", Operations{
+			Discover: func() (map[string]bool, error) { return map[string]bool{"0000:01:00.0": true}, nil },
+			Check:    func([]string) error { return nil },
+			Load:     func(string, []string) error { close(entered); <-release; return nil },
+		})
+	}()
+	<-entered
+	select {
+	case err := <-done:
+		t.Fatalf("barrier returned before insertion completed: %v", err)
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSuccessRequiresEverySelectedCard(t *testing.T) {
+	records := []string{"6,81,1234,-;pci 0000:01:00.0: gpu_unlock: unlocked\n"}
+	if err := VerifySuccess(records, []string{"0000:01:00.0"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifySuccess(records, []string{"0000:01:00.0", "0000:02:00.0"}); err == nil {
+		t.Fatal("accepted missing card")
+	}
+	if err := VerifySuccess([]string{"6,82,1235,-;pci 0000:01:00.0: gpu_unlock: unlock failed (-16)\n"}, []string{"0000:01:00.0"}); err == nil {
+		t.Fatal("accepted failed unlock")
+	}
+}
