+// SPDX-License-Identifier: MPL-2.0
+// Package gpuunlock provides an opt-in barrier before Talos starts machined.
+package gpuunlock
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+const modulePath = "usr/lib/modules/6.18.58-talos/extra/gpu_unlock.ko"
+
+var pciName = regexp.MustCompile(`^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$`)
+
+// Operations separates boot sequencing from hardware operations for local tests.
+type Operations struct {
+	Discover func() (map[string]bool, error)
+	Check    func([]string) error
+	Load     func(string, []string) error
+}
+
+// Run blocks its caller until insertion and per-card success checks finish.
+func Run(cmdline string, ops Operations) error {
+	var target string
+	for _, arg := range strings.Fields(cmdline) {
+		if value, ok := strings.CutPrefix(arg, "gpu_unlock.targets="); ok {
+			if target != "" || value == "" {
+				return errors.New("empty or duplicate gpu_unlock.targets")
+			}
+			target = strings.ToLower(value)
+		}
+	}
+	if target == "" {
+		return nil
+	}
+	devices, err := ops.Discover()
+	if err != nil {
+		return err
+	}
+	var selected []string
+	if target == "all" {
+		for name := range devices {
+			selected = append(selected, name)
+		}
+	} else {
+		for _, name := range strings.Split(target, ",") {
+			if !pciName.MatchString(name) || !devices[name] || slices.Contains(selected, name) {
+				return fmt.Errorf("invalid, unsupported, absent, or duplicate target %q", name)
+			}
+			selected = append(selected, name)
+		}
+	}
+	if len(selected) == 0 {
+		return errors.New("no supported GPU targets")
+	}
+	slices.Sort(selected)
+	if err = ops.Check(selected); err != nil {
+		return err
+	}
+	log.Printf("gpu-unlock barrier: inserting module; targets=%s", target)
+	if err = ops.Load("targets="+target, selected); err != nil {
+		return err
+	}
+	log.Printf("gpu-unlock barrier: complete; targets=%s; permitting machined", strings.Join(selected, ","))
+	return nil
+}
+
+// Boot runs after rootfs and firmware mounts, before switch_root executes machined.
+func Boot(root string) error {
+	cmdline, err := os.ReadFile("/proc/cmdline")
+	if err != nil {
+		return err
+	}
+	return Run(string(cmdline), Operations{
+		Discover: discover,
+		Check: func(targets []string) error {
+			state, err := os.ReadFile("/sys/module/module/parameters/sig_enforce")
+			if err != nil {
+				return err
+			}
+			if strings.TrimSpace(string(state)) != "N" {
+				return errors.New("module signature enforcement remains enabled")
+			}
+			for _, name := range []string{"nvidia", "nvidia_drm", "nvidia_modeset", "nvidia_uvm", "nouveau", "gpu_unlock"} {
+				if _, err := os.Stat(filepath.Join("/sys/module", name)); !errors.Is(err, os.ErrNotExist) {
+					return fmt.Errorf("refusing early unlock: module %s already present or inaccessible", name)
+				}
+			}
+			for _, name := range targets {
+				if _, err := os.Lstat(filepath.Join("/sys/bus/pci/devices", name, "driver")); !errors.Is(err, os.ErrNotExist) {
+					return fmt.Errorf("target %s already has a driver or is inaccessible", name)
+				}
+			}
+			return nil
+		},
+		Load: func(parameters string, targets []string) error {
+			fd, err := unix.Open("/dev/kmsg", unix.O_RDONLY|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+			if err != nil {
+				return err
+			}
+			defer unix.Close(fd)
+			if _, err = messages(fd); err != nil {
+				return err
+			}
+			module, err := os.Open(filepath.Join(root, modulePath))
+			if err != nil {
+				return err
+			}
+			defer module.Close()
+			if err = unix.FinitModule(int(module.Fd()), parameters, 0); err != nil {
+				return fmt.Errorf("gpu_unlock insertion failed: %w", err)
+			}
+			records, err := messages(fd)
+			if err != nil {
+				return err
+			}
+			return VerifySuccess(records, targets)
+		},
+	})
+}
+
+func discover() (map[string]bool, error) {
+	entries, err := os.ReadDir("/sys/bus/pci/devices")
+	if err != nil {
+		return nil, err
+	}
+	devices := map[string]bool{}
+	for _, entry := range entries {
+		base := filepath.Join("/sys/bus/pci/devices", entry.Name())
+		vendor, err := os.ReadFile(filepath.Join(base, "vendor"))
+		if err != nil {
+			return nil, err
+		}
+		device, err := os.ReadFile(filepath.Join(base, "device"))
+		if err != nil {
+			return nil, err
+		}
+		if strings.TrimSpace(string(vendor)) == "0x10de" && supported[strings.TrimSpace(string(device))] {
+			devices[entry.Name()] = true
+		}
+	}
+	return devices, nil
+}
+
+func messages(fd int) ([]string, error) {
+	var records []string
+	buffer := make([]byte, 65536)
+	for {
+		n, err := unix.Read(fd, buffer)
+		if errors.Is(err, unix.EAGAIN) {
+			return records, nil
+		}
+		if err != nil {
+			return nil, fmt.Errorf("cannot verify kernel log: %w", err)
+		}
+		if n == 0 {
+			return nil, errors.New("unexpected kernel log EOF")
+		}
+		records = append(records, string(buffer[:n]))
+	}
+}
+
+// VerifySuccess rejects missing success records, including upstream init returning zero after a card failure.
+func VerifySuccess(records []string, targets []string) error {
+	for _, target := range targets {
+		found := false
+		for _, record := range records {
+			_, message, ok := strings.Cut(record, ";")
+			if ok && strings.SplitN(message, "\n", 2)[0] == "pci "+target+": gpu_unlock: unlocked" {
+				found = true
+			}
+		}
+		if !found {
+			return fmt.Errorf("no completed unlock success record for %s; stopping before NVIDIA", target)
+		}
+	}
+	return nil
+}
