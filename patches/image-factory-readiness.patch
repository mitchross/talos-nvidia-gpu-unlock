+package registry_test
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/google/go-containerregistry/pkg/name"
+	v1 "github.com/google/go-containerregistry/pkg/v1"
+	"github.com/google/go-containerregistry/pkg/v1/empty"
+	"github.com/google/go-containerregistry/pkg/v1/remote"
+	"github.com/google/go-containerregistry/pkg/v1/tarball"
+	"github.com/siderolabs/gen/xerrors"
+	"github.com/siderolabs/image-factory/internal/artifacts"
+	"github.com/siderolabs/image-factory/internal/profile"
+	"github.com/siderolabs/image-factory/internal/registry"
+	"github.com/siderolabs/image-factory/pkg/schematic"
+	talosprofile "github.com/siderolabs/talos/pkg/imager/profile"
+	"github.com/stretchr/testify/require"
+)
+
+type architectureBackend struct {
+	buildBackend
+	indexes []*v1.IndexManifest
+}
+
+func (b *architectureBackend) Push(_ context.Context, _ name.Reference, value remote.Taggable) error {
+	index, ok := value.(v1.ImageIndex)
+	if !ok {
+		return errors.New("expected index")
+	}
+	manifest, err := index.IndexManifest()
+	if err != nil {
+		return err
+	}
+	b.indexes = append(b.indexes, manifest)
+	return nil
+}
+
+func TestLocalArchitectureIntersection(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		supported []string
+		failure   bool
+		wantErr   bool
+	}{
+		{"gpu-amd64", []string{"amd64"}, false, false},
+		{"stock-multiarch", []string{"amd64", "arm64"}, false, false},
+		{"no-supported-platform", nil, false, true},
+		{"ordinary-failure-is-not-skipped", []string{"amd64"}, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			repo, err := name.NewRepository("registry.example.com/cache")
+			require.NoError(t, err)
+			tag, err := name.NewTag("example.com/installer:test")
+			require.NoError(t, err)
+			var archive bytes.Buffer
+			require.NoError(t, tarball.Write(tag, empty.Image, &archive))
+			backend := &architectureBackend{}
+			var calls []string
+			service := registry.New(schematicSource{}, nil, buildAsset(archive.Bytes()), func(_ context.Context, prof talosprofile.Profile, _ *schematic.Schematic, _ string) (profile.EnhancementResult, error) {
+				if tc.failure {
+					return profile.EnhancementResult{}, errors.New("signature rejected")
+				}
+				for _, arch := range tc.supported {
+					if arch == prof.Arch {
+						return profile.EnhancementResult{Profile: prof}, nil
+					}
+				}
+				return profile.EnhancementResult{}, xerrors.NewTaggedf[artifacts.UnsupportedArchitectureTag]("no linux/%s", prof.Arch)
+			}, registry.Options{InternalRepository: repo, ExternalRepository: repo, Puller: backend, Pusher: backend, Signer: &recordingSigner{calls: &calls}})
+			_, err = service.Manifest(t.Context(), registry.Request{Image: "nocloud-installer", Schematic: strings.Repeat("b", 64), Reference: "v1.14.5"})
+			if tc.wantErr {
+				require.Error(t, err)
+				require.Empty(t, backend.indexes)
+				return
+			}
+			require.NoError(t, err)
+			require.NotEmpty(t, backend.indexes)
+			var actual []string
+			for _, descriptor := range backend.indexes[0].Manifests {
+				actual = append(actual, descriptor.Platform.Architecture)
+			}
+			require.Equal(t, tc.supported, actual)
+		})
+	}
+}
