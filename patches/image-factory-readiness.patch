+package oci_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/julienschmidt/httprouter"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+
+	"github.com/siderolabs/image-factory/internal/frontend/http/oci"
+	"github.com/siderolabs/image-factory/internal/registry"
+)
+
+func TestLocalProxyUsesBackendCredentialsWithoutForwardingCallerToken(t *testing.T) {
+	backing := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		user, pass, ok := r.BasicAuth()
+		if !ok || user != "fixture" || pass != "backend-password" {
+			w.Header().Set("WWW-Authenticate", `Basic realm="private registry"`)
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		w.Header().Set("Docker-Content-Digest", "sha256:fixture")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer backing.Close()
+	upstream := httptest.NewRequest(http.MethodGet, backing.URL, nil)
+	directory := t.TempDir()
+	config, err := json.Marshal(map[string]any{"auths": map[string]any{upstream.URL.Host: map[string]string{"auth": base64.StdEncoding.EncodeToString([]byte("fixture:backend-password"))}}})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(directory, "config.json"), config, 0o600))
+	t.Setenv("DOCKER_CONFIG", directory)
+	service := &registryStub{proxy: registry.Location{Scheme: upstream.URL.Scheme, Host: upstream.URL.Host, Repository: "factory/installer", Resource: "manifests", Reference: "fixture", Proxy: true}}
+	route := requireRoute(t, oci.NewRegistryHandler(service, zap.NewNop()).Routes(), http.MethodGet)
+	request := httptest.NewRequest(http.MethodGet, "/v2/siderolabs/image/tags/list", nil)
+	request.Header.Set("Authorization", "Bearer client-token-must-not-reach-backend")
+	response := httptest.NewRecorder()
+	require.NoError(t, route.Handler(t.Context(), response, request, httprouter.Params{{Key: "path", Value: "/siderolabs/image/tags/list"}}))
+	require.Equal(t, http.StatusOK, response.Code)
+	require.Empty(t, response.Header().Get("Location"))
+	t.Log("Authenticated native proxy passed; client token was replaced with configured backend credentials and no redirect was emitted.")
+}
