+package oci_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"github.com/julienschmidt/httprouter"
+	"github.com/siderolabs/image-factory/internal/frontend/http/oci"
+	"github.com/siderolabs/image-factory/internal/registry"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/zap"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalProxyRejectsUntrustedTLS(t *testing.T) {
+	backend := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) }))
+	defer backend.Close()
+	upstream := httptest.NewRequest(http.MethodGet, backend.URL, nil)
+	directory := t.TempDir()
+	config, err := json.Marshal(map[string]any{"auths": map[string]any{upstream.URL.Host: map[string]string{"auth": base64.StdEncoding.EncodeToString([]byte("fixture:password"))}}})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(directory, "config.json"), config, 0600))
+	t.Setenv("DOCKER_CONFIG", directory)
+	service := &registryStub{proxy: registry.Location{Scheme: "https", Host: upstream.URL.Host, Repository: "factory/installer", Resource: "manifests", Reference: "fixture", Proxy: true}}
+	route := requireRoute(t, oci.NewRegistryHandler(service, zap.NewNop()).Routes(), http.MethodGet)
+	req := httptest.NewRequest(http.MethodGet, "/v2/siderolabs/image/tags/list", nil)
+	response := httptest.NewRecorder()
+	err = route.Handler(t.Context(), response, req, httprouter.Params{{Key: "path", Value: "/siderolabs/image/tags/list"}})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "certificate")
+}
